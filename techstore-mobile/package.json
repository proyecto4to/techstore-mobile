  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "build:web": "expo export --platform web",
    "api:generate": "openapi-ts",
    "doctor": "npx expo-doctor",
    "check": "npm run typecheck && npm run lint && npm run test",
    "e2e:maestro": "maestro test e2e/maestro",
    "e2e:maestro:manual-chat": "maestro test e2e/maestro/manual/flow-b-admin-reply.yaml",
    "e2e:validate": "node scripts/validate-e2e.cjs",
    "build:validate": "node scripts/validate-build-config.cjs"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^lucide-react-native/icons/(.*)$": "<rootDir>/node_modules/lucide-react-native/dist/cjs/icons/$1.js"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|expo-router|standard-navigation|@sentry/react-native|native-base|react-native-svg|lucide-react-native)"
